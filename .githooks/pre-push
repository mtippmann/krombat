#!/usr/bin/env bash
set -euo pipefail
case "${2:-}" in
  git@github.com:mtippmann/krombat.git|https://github.com/mtippmann/krombat.git)
    exit 0
    ;;
  *)
    echo "Push blocked: only the explicitly approved mtippmann/krombat fork is allowed." >&2
    echo "The original repository deploys to AWS and must not receive these manifests." >&2
    exit 1
    ;;
esac
